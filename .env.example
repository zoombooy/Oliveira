# Oliveira 配置模板。docker compose 会自动读取本文件（复制为 .env 后生效）。

# --- LLM（任意 OpenAI 兼容端点：OpenAI / DeepSeek / Qwen / Ollama / vLLM ...） ---
# 不配置时：上传/解析/检索正常，对话接口返回 503
LLM_BASE_URL=https://api.openai.com/v1
LLM_API_KEY=
LLM_MODEL=gpt-4o-mini

# --- 嵌入 ---
# 默认维度 1024：bge-m3、Qwen text-embedding-v3 等
# 若换用其他维度（如 openai text-embedding-3-small = 1536），
# 必须同步修改 deploy/postgres/init/001_init.sql 中的 vector(1024) 并重建库
EMBEDDING_MODEL=
EMBEDDING_DIM=1024

# --- 检索与切块 ---
CHUNK_SIZE=500
CHUNK_OVERLAP=50
RETRIEVAL_TOP_K=8

# --- 本地开发直连数据库时使用（容器内由 compose 覆盖） ---
# DATABASE_URL=postgresql+asyncpg://oliveira:oliveira@localhost:5432/oliveira
